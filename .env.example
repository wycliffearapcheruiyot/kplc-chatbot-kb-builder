# MongoDB Atlas connection string (from the atlas_setup step)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-host>/?appName=Cluster0"

# Kaggle account API token (Kaggle account settings -> Create New API Token)
KAGGLE_USERNAME="your-kaggle-username"
KAGGLE_KEY="your-kaggle-api-key"

# GitHub repo holding the Kaggle notebook (serve.py + kernel-metadata.json).
# On every "Start demo" the backend downloads this repo, then starts the run on
# Kaggle with `kaggle kernels push`. Nothing heavy runs on Render.
KAGGLE_KERNEL_REPO="your-github-username/kplc-kaggle-notebook"
KAGGLE_KERNEL_REF="main"
# Only needed if that repo is PRIVATE: a fine-grained GitHub token with
# read-only "Contents" access to that one repo. Leave empty if public.
GITHUB_TOKEN=""
# Local development only: use a folder on disk instead of GitHub.
# Leave EMPTY on Render.
KAGGLE_KERNEL_DIR=""

# Optional safety nets for Kaggle runs that die without calling a webhook
# STARTING_TIMEOUT_MINUTES=15
# READY_MAX_AGE_HOURS=12

# Your fixed Cloudflare Tunnel hostname, once it exists
MODEL_TUNNEL_URL="https://model.yourdomain.com"

# Random string shared between this backend and the Kaggle notebook, used to
# verify /session/ready and /session/ended webhook calls
SESSION_WEBHOOK_SECRET="change-this-to-a-random-string"

# Comma-separated list of frontend URLs allowed to call this API
# (your Vercel dashboard, your Netlify admin panel)
ALLOWED_ORIGINS="https://your-chatbot.vercel.app,https://your-admin.netlify.app"

# ---- Kaggle dataset check (POST /dataset/ensure, GET /dataset/status) ----
# The dataset that must exist on Kaggle, as "owner/slug"
KAGGLE_DATASET="your-kaggle-username/your-dataset-slug"
# Hugging Face repo copied into that dataset when it is missing
HF_REPO_ID="your-org/your-model"
# Random string the calling service sends in the X-Webhook-Secret header
DATASET_TRIGGER_SECRET="change-this-to-another-random-string"
# Optional
# HF_REVISION=""                      # branch / tag / commit
# DATASET_TITLE=""                    # defaults to the slug
# DATASET_EXPECTED_FILE=""            # file name that must be in the dataset, e.g. config.json
# DATASET_KERNEL_SLUG="hf-to-kaggle-dataset"
# DATASET_PREPARE_TIMEOUT_MINUTES=90
